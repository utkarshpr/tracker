# Supabase project settings → API
# Auth → Providers → enable Google (Client ID + Secret from Google Cloud Console)
# Auth → URL Configuration → add Site URL + Redirect URLs (localhost + Vercel)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Then open SQL Editor and run supabase/schema.sql
#
# Google Cloud OAuth:
# 1. Create OAuth 2.0 Client (Web)
# 2. Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# 3. Paste Client ID/Secret into Supabase → Authentication → Google
#
# Also set the same VITE_SUPABASE_* vars in Vercel → Environment Variables.
